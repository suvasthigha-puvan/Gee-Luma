# Gee-Luma reads its settings from a .env file only - nothing is built into
# the code. Copy this file to .env and fill in every value. The .env file may
# sit here or in any folder above; the nearest one is used, and its values win
# over environment variables of the same name.

# Key for the AI agent that reads the request
OPENAI_API_KEY=

# Earth Engine project ID
EE_PROJECT=

# Agent model, as provider/model (for example an OpenAI model)
GEE_LUMA_MODEL=

# Port for server.py; the interface's dev server forwards API calls to it
PORT=
