# You do not need to edit this file. The first time you start Gee-Luma
# (python server.py), a setup window opens in the browser and writes your
# settings to a file called .env, next to this one.
#
# For reference, this is what that .env file holds. The app reads its
# settings from the .env file only.

# Earth Engine project ID
EE_PROJECT=

# AI model, as provider/model (for example openai/gpt-4o-mini)
LLM_MODEL=

# Key for that AI service
LLM_API_KEY=

# Port for server.py (8000 is written on the first start)
PORT=
